#include <stdio.h>

int main()
{
    int n, sl, l, i, arr[100];

    printf("Enter the limit: ");
    scanf("%d", &n);

    printf("Enter the numbers: ");
    for (i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    l = arr[0];
    sl = arr[0];

    for (i = 1; i < n; i++)
    {
        if (arr[i] > l)
        {
            sl = l;
            l = arr[i];
        }
        else if (arr[i] > sl && arr[i] != l)
        {
            sl = arr[i];
        }
    }

    printf("The largest number is: %d\n", l);
    printf("The second largest number is: %d\n", sl);

    return 0;
}
