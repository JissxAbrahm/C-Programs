#include <stdio.h>

int main()
{
    int n, i, j, temp;
    int arr[100];

    printf("Enter the limit: ");
    scanf("%d", &n);

    printf("Enter the numbers: ");
    for (i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    for (i = 0; i < n; i++)
    {
        if (arr[i] == 0)
        {
            for (j = i; j < n - 1; j++)
            {
                arr[j] = arr[j + 1];
            }

            arr[n - 1] = 0;
        }
    }

    printf("Array after moving zeros: ");

    for (i = 0; i < n; i++)
    {
        printf("%d ", arr[i]);
    }

    return 0;
}
